  "info": {
    "description": "Germany's HPC charging deserts, from the Bundesnetzagentur Ladesäulenregister (CC BY 4.0, Bundesnetzagentur.de).",
    "title": "Ladewüste API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/config": {
      "get": {
        "operationId": "get_config_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config",
        "tags": [
          "meta"
        ]
      }
    },
    "/hexes": {
      "get": {
        "operationId": "get_hexes_hexes_get",
        "parameters": [
          {
            "description": "H3 resolution: the map or the detail resolution from /config.",
            "in": "query",
            "name": "res",
            "required": true,
            "schema": {
              "description": "H3 resolution: the map or the detail resolution from /config.",
              "title": "Res",
              "type": "integer"
            }
          },
          {
            "description": "Count only points with at least this power.",
            "in": "query",
            "name": "min_kw",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Count only points with at least this power.",
              "title": "Min Kw"
            }
          },
          {
            "description": "Count only this operator's points.",
            "in": "query",
            "name": "operator",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Count only this operator's points.",
              "title": "Operator"
            }
          },
          {
            "description": "min_lon,min_lat,max_lon,max_lat (WGS84), e.g. 13.0,52.3,13.8,52.7. Required for the detail resolution.",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "min_lon,min_lat,max_lon,max_lat (WGS84), e.g. 13.0,52.3,13.8,52.7. Required for the detail resolution.",
              "title": "Bbox"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HexesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gold data missing: run `make pipeline`."
          }
        },
        "summary": "Get Hexes",
        "tags": [
          "map"
        ]
      }
    },
    "/operators": {
      "get": {
        "operationId": "get_operators_operators_get",
        "parameters": [
          {
            "description": "Case-insensitive substring of the operator name.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive substring of the operator name.",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Operator"
                  },
                  "title": "Response Get Operators Operators Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gold data missing: run `make pipeline`."
          }
        },
        "summary": "Get Operators",
        "tags": [
          "map"
        ]
      }
    },
    "/plan": {
      "get": {
        "operationId": "get_plan_plan_get",
        "parameters": [
          {
            "description": "Number of sites to place.",
            "in": "query",
            "name": "n",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Number of sites to place.",
              "maximum": 50,
              "minimum": 1,
              "title": "N",
              "type": "integer"
            }
          },
          {
            "description": "Coverage radius; defaults to desert_radius_km.",
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 5,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Coverage radius; defaults to desert_radius_km.",
